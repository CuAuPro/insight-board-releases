POSTGRES_DB=insightboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
JWT_SECRET=replace-with-a-long-random-secret
SOURCE_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
SOURCE_ENCRYPTION_KEY_ID=primary
SOURCE_ENCRYPTION_PREVIOUS_KEYS=
DEVICE_TOKEN_PEPPER=replace-with-another-long-random-secret
ASSET_MAX_FILE_BYTES=104857600
WORKSPACE_STORAGE_MAX_BYTES=2147483648
BUNDLE_MAX_UPLOAD_BYTES=262144000
BUNDLE_MAX_ENTRIES=5000
BUNDLE_MAX_EXPANDED_BYTES=1073741824
SOURCE_HTTP_ALLOWED_HOSTS=
SOURCE_DB_ALLOWED_HOSTS=
SOURCE_ALLOW_PRIVATE_NETWORKS=false
SOURCE_HTTP_MAX_RESPONSE_BYTES=10485760
SOURCE_CONNECT_TIMEOUT_MS=15000
SOURCE_QUERY_TIMEOUT_MS=30000
SOURCE_QUERY_MAX_ROWS=1000
DATASET_MAX_RECORDS=10000
DATASET_MAX_BYTES=10485760
# Retention values for automatic production cleanup and `pnpm cleanup:ops`.
CLEANUP_PAIRING_SESSION_RETENTION_HOURS=24
CLEANUP_UNPAIRED_DEVICE_RETENTION_DAYS=30
CLEANUP_SCREEN_AUDIT_RETENTION_DAYS=90
CLEANUP_DIAGNOSTICS_RETENTION_DAYS=30
REDIS_URL=redis://localhost:6379
APP_BASE_DOMAIN=boards.company.com
# Android sideload updates: override with an internal HTTPS manifest, or set empty to disable.
# ANDROID_UPDATE_MANIFEST_URL=https://github.com/CuAuPro/insight-board-releases/releases/latest/download/android-update.json
# IP-only self-hosted example:
# APP_BASE_DOMAIN=192.168.1.50
INSIGHT_BOARD_API_IMAGE=ghcr.io/cuaupro/insight-board-api:latest
INSIGHT_BOARD_WEB_IMAGE=ghcr.io/cuaupro/insight-board-web:latest
PUBLIC_API_ORIGIN=https://boards.company.com
PUBLIC_ADMIN_ORIGIN=https://boards.company.com
# IP-only self-hosted example:
# PUBLIC_API_ORIGIN=http://192.168.1.50
# PUBLIC_ADMIN_ORIGIN=http://192.168.1.50
CORS_ALLOWED_ORIGINS=https://boards.company.com
# IP-only self-hosted example:
# CORS_ALLOWED_ORIGINS=http://192.168.1.50
TRUST_PROXY=true
ACME_EMAIL=admin@company.com
